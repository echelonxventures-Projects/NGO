// DXP Platform — core Prisma schema (Phase 0)
// Multi-tenant via `tenantId` discriminator on every tenant-owned model.
// Isolation is enforced centrally (Prisma client extension + isolation guard).
// Feature modules (LMS, commerce, community, ...) extend this in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy & configuration
// ============================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique // used for <slug>.basedomain subdomains
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  domains   Domain[]
  branding  TenantBranding?
  config    TenantConfig?
  users     User[]
  roles     Role[]
  content   Content[]
  donations Donation[]
  donors    Donor[]
  subscriptions    Subscription[]
  receipts         Receipt[]
  contentRevisions ContentRevision[]
  fxRates              FxRate[]
  taxRules             TaxRule[]
  certificateTemplates CertificateTemplate[]
  certificates         Certificate[]
  courses              Course[]
  courseModules        CourseModule[]
  lessons              Lesson[]
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  products             Product[]
  orders               Order[]
  orderItems           OrderItem[]
  events               Event[]
  eventRegistrations   EventRegistration[]
  volunteerOpportunities VolunteerOpportunity[]
  volunteerSignups     VolunteerSignup[]
  membershipPlans      MembershipPlan[]
  memberships          Membership[]
  communityPosts       CommunityPost[]
  communityComments    CommunityComment[]

  // Commerce depth (Wave 1a)
  productVariants      ProductVariant[]
  coupons              Coupon[]
  reviews              Review[]
  wishlistItems        WishlistItem[]
  refunds              Refund[]

  // LMS depth (Wave 1b)
  quizzes               Quiz[]
  questions             Question[]
  quizAttempts          QuizAttempt[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  learningPaths         LearningPath[]

  // Notifications (Wave 1c)
  notifications         Notification[]

  @@map("tenants")
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

// Custom domains and subdomains mapped to a tenant. Resolution matches `hostname`.
model Domain {
  id         String       @id @default(cuid())
  tenantId   String
  hostname   String       @unique // e.g. vashundharafoundation.org or ngo.platform.local
  isPrimary  Boolean      @default(false)
  status     DomainStatus @default(PENDING)
  verifyToken String?     // DNS TXT verification token
  createdAt  DateTime     @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("domains")
}

// White-label branding. Typed columns for common fields + JSON for open-ended extension.
model TenantBranding {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  shortName    String?
  tagline      String?
  logoUrl      String?
  darkLogoUrl  String?
  faviconUrl   String?
  primaryColor String?  // e.g. #1B5E20
  accentColor  String?
  fontFamily   String?
  socialLinks  Json     @default("{}") // { twitter, facebook, instagram, linkedin, youtube }
  extra        Json     @default("{}") // any additional no-hardcode branding fields
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

// Per-tenant runtime config: feature flags, menus, provider overrides (encrypted later).
model TenantConfig {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  features    Json     @default("{}") // feature flags: { donations: true, lms: false, ... }
  menus       Json     @default("{}") // navigation structure
  settings    Json     @default("{}") // arbitrary tenant settings
  providers   Json     @default("{}") // per-tenant provider overrides (payment keys, etc.)
  // Legal / tax data used on receipts & 80G certificates (no-hardcode):
  // { legalName, address, pan, email, phone, reg80GNumber, reg80GDate, receiptPrefix }
  legal       Json     @default("{}")
  // Currency: base currency + the currencies a tenant accepts.
  baseCurrency      String  @default("INR")
  enabledCurrencies String[] @default(["INR"])
  // Tax: whether displayed prices include tax, and the fallback region for auto-detect.
  taxInclusive      Boolean @default(false)
  defaultCountry    String  @default("IN")
  defaultRegion     String? // state/province code used when address/geo absent
  defaultLocale String @default("en")
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_config")
}

// ============================================================
// Identity & RBAC
// ============================================================

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String?    // null when using external IdP (Keycloak/social) later
  name         String?
  phone        String?
  mfaSecret    String?    // TOTP secret (base32); null = not enrolled
  mfaEnabled   Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles        UserRole[]
  notifications Notification[]
  oauthAccounts OAuthAccount[]

  // Email is unique per tenant, not globally (same person may exist in many tenants).
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Roles are per-tenant so each org can define its own. System roles are seeded.
model Role {
  id          String           @id @default(cuid())
  tenantId    String
  key         String           // e.g. admin, editor, donor, student, teacher
  name        String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

// Permissions are global definitions (e.g. "content:write", "donation:read").
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // resource:action
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// CMS (dynamic content types)
// ============================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// Generic content model supporting pages, articles, programs, projects, etc.
// `type` is a free string so tenants define custom content types with no code change.
// `body` holds structured block/JSON content from the page builder.
model Content {
  id          String        @id @default(cuid())
  tenantId    String
  type        String        // page | article | program | project | story | <custom>
  slug        String
  title       String
  excerpt     String?
  body        Json          @default("{}") // block-based content
  status      ContentStatus @default(DRAFT)
  locale      String        @default("en")
  publishedAt DateTime?
  authorId    String?
  seo         Json          @default("{}") // meta title/description, og, schema.org
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revisions   ContentRevision[]

  @@unique([tenantId, type, slug, locale])
  @@index([tenantId, type, status])
  @@map("content")
}

// ============================================================
// Donations
// ============================================================

enum DonationType {
  ONE_TIME
  RECURRING
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Donor {
  id        String     @id @default(cuid())
  tenantId  String
  email     String
  name      String?
  phone     String?
  userId    String?    // optional link to a registered user
  createdAt DateTime   @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donations Donation[]
  subscriptions Subscription[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("donors")
}

model Donation {
  id            String         @id @default(cuid())
  tenantId      String
  donorId       String?
  amount        Int            // minor units (e.g. paise/cents) to avoid float errors
  currency      String         @default("INR")
  type          DonationType   @default(ONE_TIME)
  status        DonationStatus @default(PENDING)
  campaign      String?        // free-form campaign key (campaigns module added later)
  provider      String         // adapter used: mock | razorpay | stripe
  providerRef   String?        // provider intent/order id
  receiptNumber String?        // assigned on success
  subscriptionId String?       // set when this donation is a recurring cycle charge
  // Tax snapshot (region auto-detected at creation; rate/amount frozen on the record).
  taxCountry    String?
  taxRegion     String?        // state/province
  taxRatePct    Float          @default(0)
  taxAmount     Int            @default(0) // minor units, same currency as `currency`
  taxBreakdown  Json           @default("[]") // [{name, ratePct, amount}]
  // FX snapshot: value of this donation in the tenant base currency at time of creation.
  baseCurrency  String?
  fxRate        Float?         // 1 unit `currency` = fxRate units baseCurrency
  baseAmount    Int?           // minor units in baseCurrency
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor         Donor?         @relation(fields: [donorId], references: [id], onDelete: SetNull)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  receipt       Receipt?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([subscriptionId])
  @@map("donations")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// A recurring donation mandate. Each successful cycle creates a Donation row linked back.
model Subscription {
  id           String               @id @default(cuid())
  tenantId     String
  donorId      String?
  amount       Int                  // minor units per cycle
  currency     String               @default("INR")
  interval     SubscriptionInterval @default(MONTHLY)
  status       SubscriptionStatus   @default(ACTIVE)
  campaign     String?
  provider     String
  providerRef  String?              // provider subscription id
  nextChargeAt DateTime?
  metadata     Json                 @default("{}")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor        Donor?               @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donations    Donation[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

// Issued receipt for a successful donation. Carries a snapshot of 80G/tax data so the
// certificate stays valid even if tenant config changes later.
model Receipt {
  id            String   @id @default(cuid())
  tenantId      String
  donationId    String   @unique
  number        String   // human-facing receipt number (per-tenant sequence)
  amount        Int
  currency      String   @default("INR")
  issuedAt      DateTime @default(now())
  donorName     String?
  donorEmail    String?
  // Snapshot of issuing org's legal/80G data at time of issue:
  orgLegalName  String?
  orgAddress    String?
  orgPan        String?
  reg80GNumber  String?
  reg80GDate    String?
  is80GEligible Boolean  @default(false)
  metadata      Json     @default("{}")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donation      Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("receipts")
}

// Immutable snapshot of a Content item at each save/publish, for version history.
model ContentRevision {
  id          String   @id @default(cuid())
  tenantId    String
  contentId   String
  version     Int
  title       String
  excerpt     String?
  body        Json     @default("{}")
  seo         Json     @default("{}")
  status      String
  authorId    String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([tenantId, contentId])
  @@map("content_revisions")
}

// ============================================================
// Currency / FX
// ============================================================

// Per-tenant exchange rates. `rate` converts 1 unit of `base` into `quote`.
// Seeded/manual by default; a live adapter can upsert these from a free FX API.
model FxRate {
  id        String   @id @default(cuid())
  tenantId  String
  base      String   // ISO 4217, e.g. USD
  quote     String   // ISO 4217, e.g. INR
  rate      Float
  source    String   @default("manual") // manual | frankfurter | ...
  fetchedAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, base, quote])
  @@index([tenantId])
  @@map("fx_rates")
}

// ============================================================
// Tax engine (jurisdiction rules)
// ============================================================

// A tax rule for a jurisdiction. Most specific match wins:
// country+region+category > country+region > country+category > country.
// `region` null = applies to the whole country; `category` null = all categories.
model TaxRule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   // e.g. "GST", "VAT", "CA Sales Tax"
  country   String   // ISO 3166-1 alpha-2, e.g. IN
  region    String?  // state/province code, e.g. MH
  category  String?  // product/category key; null = all
  ratePct   Float    // e.g. 18 for 18%
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, country, region])
  @@map("tax_rules")
}

// ============================================================
// Certificate engine (templates + issued certificates)
// ============================================================

// A per-tenant certificate template. `type` distinguishes 80G, course, volunteer, etc.
// `template` holds the print-ready HTML with {{placeholders}} resolved at issue time.
model CertificateTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  type      String   // tax80g | course | volunteer | <custom>
  name      String
  template  String   // HTML with {{placeholders}}
  fields    Json     @default("[]") // declared placeholder field names
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@unique([tenantId, type, name])
  @@index([tenantId, type])
  @@map("certificate_templates")
}

// An issued certificate instance. `code` is a public verification code; `data` is the
// snapshot of values rendered into the template (so it never changes retroactively).
model Certificate {
  id          String   @id @default(cuid())
  tenantId    String
  templateId  String
  type        String
  code        String   // public verification code (globally unique)
  subjectName String?
  subjectEmail String?
  data        Json     @default("{}") // snapshot of placeholder values
  renderedHtml String   // frozen rendered HTML
  refType     String?  // e.g. donation | receipt | enrollment
  refId       String?  // id of the referenced record
  issuedAt    DateTime @default(now())
  revokedAt   DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([code])
  @@index([tenantId, type])
  @@index([tenantId, refType, refId])
  @@map("certificates")
}


// ============================================================
// LMS (courses, modules, lessons, enrollment, progress)
// ============================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  PDF
  QUIZ
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// A course is the top-level learning container. `price` is in minor units; 0 = free.
model Course {
  id           String       @id @default(cuid())
  tenantId     String
  slug         String
  title        String
  summary      String?
  description  String?      @db.Text
  coverUrl     String?
  status       CourseStatus @default(DRAFT)
  price        Int          @default(0) // minor units; 0 = free
  currency     String       @default("INR")
  instructorId String?      // User id of the teacher (optional)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules      CourseModule[]
  enrollments  Enrollment[]
  quizzes      Quiz[]
  assignments  Assignment[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("courses")
}

// A section within a course, ordered.
model CourseModule {
  id        String   @id @default(cuid())
  tenantId  String
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([tenantId])
  @@index([courseId])
  @@map("course_modules")
}

// An individual lesson. `content` is block/JSON for TEXT; video/pdf use url fields.
model Lesson {
  id          String     @id @default(cuid())
  tenantId    String
  moduleId    String
  title       String
  type        LessonType @default(TEXT)
  order       Int        @default(0)
  content     Json       @default("{}")
  videoUrl    String?
  durationSec Int        @default(0)
  isPreview   Boolean    @default(false) // viewable without enrollment
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@index([tenantId])
  @@index([moduleId])
  @@map("lessons")
}

// A user's enrollment in a course, with derived progress percentage.
model Enrollment {
  id          String           @id @default(cuid())
  tenantId    String
  courseId    String
  userId      String
  status      EnrollmentStatus @default(ACTIVE)
  progressPct Int              @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@unique([tenantId, courseId, userId])
  @@index([tenantId, userId])
  @@map("enrollments")
}

// Per-lesson completion tracking for an enrollment.
model LessonProgress {
  id           String    @id @default(cuid())
  tenantId     String
  enrollmentId String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([tenantId])
  @@map("lesson_progress")
}

// ---- LMS depth (Wave 1b): quizzes, assignments, exams, learning paths ----

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

// A quiz/exam attached to a course. `isExam` distinguishes graded exams from practice
// quizzes; `passingScore` is a percentage (0..100).
model Quiz {
  id           String   @id @default(cuid())
  tenantId     String
  courseId     String
  title        String
  description  String?  @db.Text
  passingScore Int      @default(60)
  timeLimitSec Int?
  isExam       Boolean  @default(false)
  shuffle      Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]

  @@index([tenantId])
  @@index([courseId])
  @@map("quizzes")
}

// A question within a quiz. `options` is a JSON array of { id, text }; `correct` is a JSON
// array of correct option ids. Correct answers are never sent to learners.
model Question {
  id        String       @id @default(cuid())
  tenantId  String
  quizId    String
  prompt    String       @db.Text
  type      QuestionType @default(SINGLE)
  options   Json         @default("[]")
  correct   Json         @default("[]")
  points    Int          @default(1)
  order     Int          @default(0)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quizId])
  @@map("questions")
}

// A learner's attempt at a quiz. `answers` is a JSON map of questionId -> option id(s).
model QuizAttempt {
  id          String        @id @default(cuid())
  tenantId    String
  quizId      String
  userId      String
  answers     Json          @default("{}")
  score       Int           @default(0) // percentage 0..100
  passed      Boolean       @default(false)
  status      AttemptStatus @default(SUBMITTED)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quizId, userId])
  @@map("quiz_attempts")
}

// A course assignment that learners submit (file URL or text). Graded by a teacher.
model Assignment {
  id           String   @id @default(cuid())
  tenantId     String
  courseId     String
  title        String
  instructions String?  @db.Text
  dueAt        DateTime?
  maxPoints    Int      @default(100)
  createdAt    DateTime @default(now())

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]

  @@index([tenantId])
  @@index([courseId])
  @@map("assignments")
}

// A learner's submission for an assignment, with teacher grade/feedback.
model AssignmentSubmission {
  id           String           @id @default(cuid())
  tenantId     String
  assignmentId String
  userId       String
  fileUrl      String?
  text         String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([tenantId])
  @@map("assignment_submissions")
}

// An ordered sequence of courses (a curriculum). `courseIds` is an ordered JSON array.
model LearningPath {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  description String?  @db.Text
  courseIds   Json     @default("[]")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("learning_paths")
}


// ============================================================
// Commerce (products + orders)
// ============================================================

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

// A sellable product. `price` is in minor units. Physical products track `stock`
// (null = untracked); digital products ignore stock.
model Product {
  id          String        @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  description String?       @db.Text
  type        ProductType   @default(PHYSICAL)
  status      ProductStatus @default(DRAFT)
  price       Int           @default(0) // minor units
  currency    String        @default("INR")
  category    String?       // free-form category key
  imageUrl    String?
  vendorId    String?       // marketplace: owning vendor (null = first-party / platform)
  stock       Int?          // null = not tracked / unlimited (digital)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("products")
}

// A customer order. Totals are snapshotted in minor units; `provider` records the payment
// adapter used (mock by default, consistent with donations).
model Order {
  id            String      @id @default(cuid())
  tenantId      String
  userId        String?     // optional link to a registered user
  customerEmail String
  customerName  String?
  status        OrderStatus @default(PENDING)
  subtotal      Int         @default(0)
  discount      Int         @default(0)
  couponCode    String?
  total         Int         @default(0)
  currency      String      @default("INR")
  provider      String      @default("mock")
  providerRef   String?
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  refunds       Refund[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

// A line item within an order. Title/price snapshotted so history is stable.
model OrderItem {
  id            String   @id @default(cuid())
  tenantId      String
  orderId       String
  productId     String?
  variantId     String?
  titleSnapshot String
  unitPrice     Int
  quantity      Int      @default(1)
  lineTotal     Int

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

// ---- Commerce depth (Wave 1a): variants, coupons, reviews, wishlist, refunds ----

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

// A purchasable variant of a product (e.g. size/colour). `priceDelta` is added to the
// product's base price (minor units). `stock` null = untracked.
model ProductVariant {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  sku        String?
  name       String
  priceDelta Int      @default(0)
  stock      Int?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

// Discount code. PERCENT value is 0..100; FIXED value is minor units. Redemptions are
// capped by `maxRedemptions` (null = unlimited) and `expiresAt`.
model Coupon {
  id             String     @id @default(cuid())
  tenantId       String
  code           String
  type           CouponType @default(PERCENT)
  value          Int        @default(0)
  minSubtotal    Int        @default(0)
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

// Product rating/review. `rating` is 1..5. Moderation via `status`.
model Review {
  id         String       @id @default(cuid())
  tenantId   String
  productId  String
  userId     String?
  authorName String?
  rating     Int
  body       String?      @db.Text
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId, status])
  @@map("reviews")
}

// A user's saved product. Unique per (tenant, user, product).
model WishlistItem {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  productId String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, productId])
  @@index([tenantId, userId])
  @@map("wishlist_items")
}

// A refund/return request against an order. `amount` in minor units.
model Refund {
  id        String       @id @default(cuid())
  tenantId  String
  orderId   String
  amount    Int
  reason    String?
  status    RefundStatus @default(REQUESTED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("refunds")
}


// ============================================================
// Events
// ============================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventMode {
  ONLINE
  PHYSICAL
  HYBRID
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

model Event {
  id          String      @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  description String?     @db.Text
  mode        EventMode   @default(PHYSICAL)
  location    String?     // venue or stream URL
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?        // null = unlimited
  price       Int         @default(0)
  currency    String      @default("INR")
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("events")
}

model EventRegistration {
  id         String             @id @default(cuid())
  tenantId   String
  eventId    String
  userId     String?
  email      String
  name       String?
  ticketCode String             @unique
  status     RegistrationStatus @default(REGISTERED)
  checkedInAt DateTime?
  createdAt  DateTime           @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([tenantId])
  @@map("event_registrations")
}

// ============================================================
// Volunteers
// ============================================================

enum VolunteerSignupStatus {
  APPLIED
  APPROVED
  REJECTED
  COMPLETED
}

model VolunteerOpportunity {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?  @db.Text
  location    String?
  startsAt    DateTime?
  slots       Int?     // null = unlimited
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signups     VolunteerSignup[]

  @@index([tenantId, active])
  @@map("volunteer_opportunities")
}

model VolunteerSignup {
  id            String                @id @default(cuid())
  tenantId      String
  opportunityId String
  userId        String?
  email         String
  name          String?
  status        VolunteerSignupStatus @default(APPLIED)
  hours         Int                   @default(0)
  createdAt     DateTime              @default(now())

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity   VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, email])
  @@index([tenantId])
  @@map("volunteer_signups")
}

// ============================================================
// Membership
// ============================================================

enum MembershipInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model MembershipPlan {
  id        String             @id @default(cuid())
  tenantId  String
  slug      String
  name      String
  price     Int                @default(0)
  currency  String             @default("INR")
  interval  MembershipInterval @default(MONTHLY)
  benefits  Json               @default("[]") // string[]
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@map("membership_plans")
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  planId    String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  startedAt DateTime         @default(now())
  expiresAt DateTime?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("memberships")
}

// ============================================================
// Community
// ============================================================

model CommunityPost {
  id         String   @id @default(cuid())
  tenantId   String
  authorId   String?
  authorName String?
  title      String
  body       String   @db.Text
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comments   CommunityComment[]

  @@index([tenantId, createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id         String   @id @default(cuid())
  tenantId   String
  postId     String
  authorId   String?
  authorName String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([tenantId, postId])
  @@map("community_comments")
}


// ============================================================
// Notifications (multi-channel platform)
// ============================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
  TELEGRAM
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// A notification delivered (or attempted) on a single channel. In-app notifications are
// queried back by the recipient; other channels are persisted as an audit/outbox record.
model Notification {
  id        String              @id @default(cuid())
  tenantId  String
  userId    String?             // recipient user (required for IN_APP; null for external-only)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  type      String              // event/template key, e.g. "user.welcome", "donation.receipt"
  title     String
  body      String              @db.Text
  data      Json                @default("{}") // structured payload (links, ids, cta)
  to        String?             // external address snapshot (email/phone/webhook url)
  error     String?             // failure reason when status = FAILED
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, status])
  @@index([userId, readAt])
  @@map("notifications")
}

// ============================================================
// AI platform (conversation persistence)
//
// Tenant-owned via the `tenantId` column (isolation enforced by the Prisma scoped() client
// extension + isolation guard). Newer feature modules use the column-only pattern rather than
// a declared Tenant back-relation to stay self-contained; cross-model relations within a
// module still use proper foreign keys (see AiMessage -> AiConversation).
// ============================================================

model AiConversation {
  id        String      @id @default(cuid())
  tenantId  String
  userId    String?
  feature   String      @default("chat") // chat | tutor | content | quiz | summary | ...
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AiMessage[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  tenantId       String
  conversationId String
  role           String         // system | user | assistant
  content        String         @db.Text
  provider       String?
  model          String?
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@map("ai_messages")
}

// ============================================================
// Digital Library (federation bookmarks)
// ============================================================

model LibraryBookmark {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  source       String   // connector name: openlibrary | gutenberg | internet-archive
  externalId   String
  title        String
  authors      Json     @default("[]")
  url          String
  thumbnailUrl String?
  format       String?
  license      String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, userId, source, externalId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("library_bookmarks")
}

// ============================================================
// Commerce completion: categories, shipping, invoices, returns
// ============================================================

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ProductCategory {
  id        String            @id @default(cuid())
  tenantId  String
  slug      String
  name      String
  parentId  String?
  order     Int               @default(0)
  createdAt DateTime          @default(now())

  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("CategoryTree")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_categories")
}

model ShippingMethod {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  price       Int      @default(0) // flat rate, minor units
  currency    String   @default("INR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("shipping_methods")
}

model Shipment {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String
  methodId       String?
  methodName     String
  cost           Int            @default(0)
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  address        Json           @default("{}")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
  @@index([orderId])
  @@map("shipments")
}

model Invoice {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  number    String
  subtotal  Int      @default(0)
  discount  Int      @default(0)
  shipping  Int      @default(0)
  tax       Int      @default(0)
  total     Int      @default(0)
  currency  String   @default("INR")
  issuedAt  DateTime @default(now())
  data      Json     @default("{}")

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([orderId])
  @@map("invoices")
}

model OrderReturn {
  id        String       @id @default(cuid())
  tenantId  String
  orderId   String
  reason    String?
  status    ReturnStatus @default(REQUESTED)
  items     Json         @default("[]") // [{ orderItemId, quantity }]
  refundId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId])
  @@index([orderId])
  @@map("order_returns")
}

// ============================================================
// Multi-vendor marketplace
// ============================================================

enum VendorType {
  NGO
  SHG               // self-help group
  ARTISAN
  WOMEN_ENTREPRENEUR
  TRAINER
  OTHER
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PAID
}

model Vendor {
  id            String       @id @default(cuid())
  tenantId      String
  userId        String?      // owning user (applicant)
  slug          String
  name          String
  type          VendorType   @default(OTHER)
  status        VendorStatus @default(PENDING)
  commissionPct Int          @default(1500) // basis points retained by platform (1500 = 15%)
  bio           String?      @db.Text
  logoUrl       String?
  payoutDetails Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("vendors")
}

model VendorPayout {
  id          String       @id @default(cuid())
  tenantId    String
  vendorId    String
  grossSales  Int          @default(0) // minor units of vendor sales in the period
  commission  Int          @default(0) // platform commission retained
  netAmount   Int          @default(0) // paid out to vendor
  currency    String       @default("INR")
  status      PayoutStatus @default(PENDING)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?

  @@index([tenantId])
  @@index([tenantId, vendorId])
  @@map("vendor_payouts")
}

// ============================================================
// LMS completion: exams, notes, discussions, attendance, IDs
// ============================================================

enum ExamType {
  MCQ
  ESSAY
  SUBJECTIVE
  VIVA
  CODING
  FILE_UPLOAD
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Exam {
  id          String   @id @default(cuid())
  tenantId    String
  courseId    String
  title       String
  type        ExamType @default(MCQ)
  durationMin Int      @default(60)
  totalPoints Int      @default(100)
  passingPct  Int      @default(40)
  randomize   Boolean  @default(false)
  questions   Json     @default("[]") // [{ prompt, options?, correctIndex?, points }]
  scheduledAt DateTime?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts    ExamAttempt[]

  @@index([tenantId])
  @@index([tenantId, courseId])
  @@map("exams")
}

model ExamAttempt {
  id          String            @id @default(cuid())
  tenantId    String
  examId      String
  userId      String
  answers     Json              @default("{}")
  score       Int               @default(0)
  passed      Boolean           @default(false)
  status      ExamAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  exam        Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([examId, userId])
  @@map("exam_attempts")
}

model LessonNote {
  id        String   @id @default(cuid())
  tenantId  String
  lessonId  String
  userId    String
  body      String   @db.Text
  timestamp Int?     // optional video position (seconds)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, lessonId, userId])
  @@map("lesson_notes")
}

model Discussion {
  id        String            @id @default(cuid())
  tenantId  String
  courseId  String
  lessonId  String?
  userId    String
  title     String
  body      String            @db.Text
  pinned    Boolean           @default(false)
  createdAt DateTime          @default(now())

  replies   DiscussionReply[]

  @@index([tenantId])
  @@index([tenantId, courseId])
  @@map("discussions")
}

model DiscussionReply {
  id           String     @id @default(cuid())
  tenantId     String
  discussionId String
  userId       String
  body         String     @db.Text
  createdAt    DateTime   @default(now())

  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([discussionId])
  @@map("discussion_replies")
}

model ClassAttendance {
  id        String           @id @default(cuid())
  tenantId  String
  courseId  String
  userId    String
  sessionId String?          // optional live-session link
  date      DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)
  method    String?          // qr | manual | live
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, courseId, userId])
  @@map("class_attendance")
}

model StudentProfile {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  enrollmentNo String
  qrPayload    String   // scannable identity token (deep-link / id)
  guardian     String?
  phone        String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, userId])
  @@unique([tenantId, enrollmentNo])
  @@index([tenantId])
  @@map("student_profiles")
}

model TeacherProfile {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  staffId   String
  qrPayload String
  bio       String?  @db.Text
  subjects  Json     @default("[]")
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@unique([tenantId, staffId])
  @@index([tenantId])
  @@map("teacher_profiles")
}

// ============================================================
// Live class platform
// ============================================================

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum LiveRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model LiveSession {
  id           String            @id @default(cuid())
  tenantId     String
  courseId     String?
  title        String
  description  String?           @db.Text
  provider     String            @default("jitsi")
  roomName     String
  joinUrl      String
  hostId       String?
  hostName     String?
  scheduledAt  DateTime
  durationMin  Int               @default(60)
  recurrence   LiveRecurrence    @default(NONE)
  status       LiveSessionStatus @default(SCHEDULED)
  recordingUrl String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  attendance   LiveAttendance[]

  @@index([tenantId])
  @@index([tenantId, courseId])
  @@index([tenantId, scheduledAt])
  @@map("live_sessions")
}

model LiveAttendance {
  id        String      @id @default(cuid())
  tenantId  String
  sessionId String
  userId    String
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?

  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([tenantId])
  @@map("live_attendance")
}

// ============================================================
// Engagement completion: volunteer hour logs, membership benefits
// ============================================================

model VolunteerHourLog {
  id        String   @id @default(cuid())
  tenantId  String
  signupId  String
  hours     Int      @default(0)
  date      DateTime @default(now())
  note      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, signupId])
  @@map("volunteer_hour_logs")
}

model MembershipBenefit {
  id          String   @id @default(cuid())
  tenantId    String
  planId      String
  key         String   // e.g. "discount", "exclusive_content", "community_access", "certificate"
  label       String
  value       String?  // e.g. "10" (percent) for discount
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, planId])
  @@map("membership_benefits")
}

// ============================================================
// Ad management platform
// ============================================================

enum AdType {
  BANNER
  VIDEO
  NATIVE
  SPONSORED
  AFFILIATE
  CAMPAIGN
}

model AdPlacement {
  id          String   @id @default(cuid())
  tenantId    String
  key         String   // slot identifier, e.g. "home_top", "sidebar"
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  ads         Ad[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("ad_placements")
}

model Ad {
  id          String       @id @default(cuid())
  tenantId    String
  placementId String?
  name        String
  type        AdType       @default(BANNER)
  imageUrl    String?
  videoUrl    String?
  html        String?      @db.Text
  targetUrl   String?
  weight      Int          @default(1) // relative weight for weighted rotation
  active      Boolean      @default(true)
  startAt     DateTime?
  endAt       DateTime?
  // Targeting: arrays of allowed values; empty/absent = match all.
  targeting   Json         @default("{}") // { country?, state?, city?, language?, device?, role?, membership? }
  impressions Int          @default(0)
  clicks      Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  placement   AdPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("ads")
}

model AdImpression {
  id        String   @id @default(cuid())
  tenantId  String
  adId      String
  context   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, adId])
  @@map("ad_impressions")
}

model AdClick {
  id        String   @id @default(cuid())
  tenantId  String
  adId      String
  context   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, adId])
  @@map("ad_clicks")
}

// ============================================================
// Deep linking / smart links
// ============================================================

model SmartLink {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String   // short code in the share URL
  targetUrl   String   // default (web) destination
  androidUrl  String?  // android deep link / intent
  iosUrl      String?  // ios universal link / scheme
  fallbackUrl String?  // store/marketing fallback
  title       String?
  campaign    String?  // campaign tag for attribution
  referrerId  String?  // referring user for referral links
  qrPayload   String
  clicks      Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("smart_links")
}

model SmartLinkClick {
  id        String   @id @default(cuid())
  tenantId  String
  linkId    String
  platform  String?  // android | ios | web
  userAgent String?
  referrer  String?
  context   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, linkId])
  @@map("smart_link_clicks")
}

// ============================================================
// Analytics platform
// ============================================================

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  type      String   // pageview | donation | sale | enrollment | signup | event_register | ...
  name      String?  // optional sub-name / label
  userId    String?
  sessionId String?
  path      String?
  value     Int      @default(0) // optional numeric value (minor units / count)
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, type, createdAt])
  @@map("analytics_events")
}

// ============================================================
// Auth completion: OAuth accounts + OTP challenges
// ============================================================

model OAuthAccount {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  provider       String   // google | github | facebook | linkedin | apple
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, providerUserId])
  @@index([tenantId])
  @@map("oauth_accounts")
}

model OtpChallenge {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String   // sms | email
  recipient String   // phone or email
  codeHash  String
  purpose   String   @default("login") // login | verify
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, recipient])
  @@map("otp_challenges")
}

// ============================================================
// Security: audit logs
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  // null for pre-tenant / platform routes
  userId     String?
  method     String
  path       String
  statusCode Int?
  ip         String?
  userAgent  String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================================
// CRM + fundraising campaigns + sponsorship
// ============================================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SponsorshipType {
  CHILD
  EDUCATION
  ENVIRONMENT
  HEALTHCARE
  OTHER
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  email     String?
  phone     String?
  name      String?
  type      String   @default("lead") // lead | donor | volunteer | partner | beneficiary
  tags      Json     @default("[]")
  source    String?  // signup | donation | import | event | ...
  ownerId   String?  // staff member who owns the relationship
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ContactActivity[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("contacts")
}

model ContactActivity {
  id        String   @id @default(cuid())
  tenantId  String
  contactId String
  kind      String   // note | call | email | meeting | task
  summary   String
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@map("contact_activities")
}

model Campaign {
  id           String         @id @default(cuid())
  tenantId     String
  slug         String
  title        String
  description  String?        @db.Text
  goalAmount   Int            @default(0) // minor units
  raisedAmount Int            @default(0) // denormalized; recomputed from donations
  currency     String         @default("INR")
  coverUrl     String?
  status       CampaignStatus @default(DRAFT)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("campaigns")
}

model Sponsorship {
  id              String            @id @default(cuid())
  tenantId        String
  type            SponsorshipType   @default(CHILD)
  sponsorEmail    String
  sponsorName     String?
  sponsorUserId   String?
  beneficiaryName String?
  beneficiaryRef  String?           // anonymized beneficiary id
  amount          Int               @default(0) // per-interval, minor units
  currency        String            @default("INR")
  interval        MembershipInterval @default(MONTHLY)
  status          SponsorshipStatus @default(ACTIVE)
  startedAt       DateTime          @default(now())
  nextRenewalAt   DateTime?
  createdAt       DateTime          @default(now())

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("sponsorships")
}

// ============================================================
// Website + theme builder
// ============================================================

enum PageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Page {
  id          String     @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  status      PageStatus @default(DRAFT)
  blocks      Json       @default("[]") // ordered [{ id, type, props }]
  seo         Json       @default("{}")
  version     Int        @default(1)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  revisions   PageRevision[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("pages")
}

model PageRevision {
  id        String   @id @default(cuid())
  tenantId  String
  pageId    String
  version   Int
  blocks    Json     @default("[]")
  createdAt DateTime @default(now())

  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pageId])
  @@map("page_revisions")
}

model Theme {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  name      String
  tokens    Json     @default("{}") // { colors, fonts, radius, spacing, mode }
  source    String   @default("custom") // custom | imported | marketplace
  version   Int      @default(1)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("themes")
}

// ============================================================
// PWA / push subscriptions
// ============================================================

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([tenantId, endpoint])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("push_subscriptions")
}
