# ============================================================
# DXP Platform — environment configuration
# Free-first defaults. Copy to .env and adjust per environment.
# NOTHING is hardcoded in the app; all of this is read at runtime.
# ============================================================

# --- Runtime ---
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated allowed CORS origins (use * only in dev)
CORS_ORIGINS=http://localhost:2222

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://dxp:dxp@localhost:5433/dxp?schema=public

# --- Redis (cache / queues / events) ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT (Phase 0 local auth; Keycloak adapter added later) ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=3600s
JWT_REFRESH_EXPIRES_IN=30d

# --- Tenant resolution ---
# Base domain used to derive subdomain tenants, e.g. <slug>.platform.local
PLATFORM_BASE_DOMAIN=platform.local
# Tenant slug used when no host match is found (dev convenience). Empty = strict.
DEFAULT_TENANT_SLUG=vashundhara
# Header that may override tenant in trusted internal calls
TENANT_HEADER=x-tenant

# --- Provider adapters (swappable; free-first defaults) ---
# Storage: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/uploads
# S3 (only used when STORAGE_PROVIDER=s3) — works with MinIO too
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email: smtp | log
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@platform.local

# AI: echo (free, offline default) | ollama | openai | gemini | anthropic | openrouter | deepseek | mistral
AI_PROVIDER=echo
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_GEMINI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_OPENROUTER_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_MISTRAL_API_KEY=

# Live class: jitsi (free default)
LIVECLASS_PROVIDER=jitsi
LIVECLASS_JITSI_BASE_URL=https://meet.jit.si

# Translation: echo (free, offline default) | libretranslate (free, self-hostable)
TRANSLATION_PROVIDER=echo
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# Speech (TTS/STT): stub (free default) | whisper/piper/coqui (self-hosted)
SPEECH_PROVIDER=stub

# Rate limiting (per IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_TTL_MS=60000

# Public web URL (used for smart-link share URLs / QR)
PUBLIC_WEB_URL=http://localhost:3000

# Payments: mock | razorpay | stripe (per-tenant overrides stored in DB)
PAYMENT_PROVIDER=mock

# FX rates: seeded (offline, tenant-managed FxRate table) | frankfurter (live, free, no key)
FX_PROVIDER=seeded

# Domain verification: allow manual token-echo verify (DEV/TEST ONLY — never true in prod)
DOMAIN_VERIFY_ALLOW_MANUAL=false
